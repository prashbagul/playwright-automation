{
  "name": "playwright-flipkart-cucumber-framework",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "test": "npm run clean && node scripts/run-tests.cjs",
    "test:parallel": "npm run clean && node scripts/run-tests.cjs --parallel 3",
    "test:parallel:5": "npm run clean && node scripts/run-tests.cjs --parallel 5",
    "test:parallel:10": "npm run clean && node scripts/run-tests.cjs --parallel 10",
    "report": "node scripts/generate-report.cjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,json,md}\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/node": "^22.13.0",
    "exceljs": "^4.4.0",
    "multiple-cucumber-html-reporter": "^3.9.0",
    "playwright": "^1.51.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "@playwright/test": "^1.51.0",
    "prettier": "^3.5.3"
  }
}
